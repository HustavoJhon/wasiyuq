{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "build/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [],
      "cache": false,
      "env": [
        "TEST_DATABASE_URL",
        "DATABASE_URL",
        "DB_MIGRATION_ALLOWED_DATABASES",
        "DB_POOL_MAX",
        "DB_CONNECT_TIMEOUT_SECONDS",
        "NODE_ENV",
        "LOG_LEVEL"
      ]
    },
    "format": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
