{
  "name": "@wasiyuq/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env run --hot src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "bun --env-file=../../.env run dist/index.js",
    "lint": "echo 'lint:api ok'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun --env-file=../../.env test ./src --pass-with-no-tests",
    "format": "echo 'format:api ok'",
    "admin:grant": "bun --env-file=../../.env src/cli/grant-platform-admin.ts"
  },
  "dependencies": {
    "@wasiyuq/db": "workspace:*",
    "@wasiyuq/module-identity": "workspace:*",
    "@wasiyuq/module-organizations": "workspace:*",
    "@wasiyuq/validation": "workspace:*",
    "hono": "^4.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "drizzle-orm": "0.45.4",
    "typescript": "^5.8.0"
  }
}
