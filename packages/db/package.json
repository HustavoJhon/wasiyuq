{
  "name": "@wasiyuq/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "echo 'lint:db ok'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun --env-file=../../.env test ./src --pass-with-no-tests",
    "format": "echo 'format:db ok'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env src/cli/migrate.ts development",
    "db:migrate:test": "bun --env-file=../../.env src/cli/migrate.ts test",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "postgres": "^3.4.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "drizzle-kit": "0.31.11",
    "typescript": "^5.8.0"
  }
}
