# WASIYUQ 2.0 - development environment example
# Copy to `.env` at the repository root: cp .env.example .env

# API
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL (infra/docker/docker-compose.yml)
# Host port 55432 avoids clashing with other local PostgreSQL instances on 5432.
POSTGRES_USER=wasiyuq
POSTGRES_PASSWORD=wasiyuq
POSTGRES_DB=wasiyuq_dev
POSTGRES_TEST_DB=wasiyuq_test
POSTGRES_PORT=55432

# Database connections used by @wasiyuq/db
DATABASE_URL=postgresql://wasiyuq:wasiyuq@127.0.0.1:55432/wasiyuq_dev
TEST_DATABASE_URL=postgresql://wasiyuq:wasiyuq@127.0.0.1:55432/wasiyuq_test

# Optional pool/timeouts
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT_SECONDS=5

# Migration safeguards: comma-separated database names that migrations may target.
# Migrations refuse any database not listed here, any non-local host and any production environment.
DB_MIGRATION_ALLOWED_DATABASES=wasiyuq_dev,wasiyuq_test

# Authentication (Better Auth, modules/identity)
# Secret used to sign cookies/tokens. Generate one with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Public origin that serves /api/auth to browsers. In development the web app proxies /api to the API,
# so this is the web origin.
AUTH_BASE_URL=http://localhost:5173
# Web application origin (links in emails, trusted origin for CSRF checks)
WEB_APP_URL=http://localhost:5173
# Extra trusted origins, comma-separated (optional)
# AUTH_TRUSTED_ORIGINS=
# on|off. Auth endpoints rate limiting (database-backed). Cannot be off in production.
AUTH_RATE_LIMIT=on
# true only behind a single trusted reverse proxy that appends X-Forwarded-For
AUTH_TRUST_PROXY=false
# Google OAuth (optional: enabled only when both are set)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Maximum simultaneous password hashes (scrypt, 32 MiB each). Default: half the CPU cores, at least 2.
# AUTH_PASSWORD_HASH_CONCURRENCY=

# Email (docs/technical/EMAIL_DELIVERY.md)
# Transport: smtp (real delivery; Mailpit in development) | console (prints messages, development only) | memory (tests)
# Production requires smtp with tls/starttls, provider credentials and a verified sending domain.
MAIL_TRANSPORT=smtp
MAIL_FROM_NAME=WASIYUQ
MAIL_FROM_ADDRESS=no-reply@wasiyuq.test
# Development: Mailpit from infra/docker (UI at http://127.0.0.1:58025). Production: the provider's SMTP host.
SMTP_HOST=127.0.0.1
SMTP_PORT=51025
# tls (implicit TLS, port 465) | starttls (port 587) | none (local Mailpit only; refused in production)
SMTP_SECURITY=none
# Provider credentials (placeholders only; never commit real values)
# SMTP_USER=
# SMTP_PASSWORD=
# Delivery attempts per email (transient failures only) and delay before the first retry
MAIL_MAX_ATTEMPTS=3
MAIL_RETRY_BASE_DELAY_MS=1000

# Mailpit ports (infra/docker) and API used by the optional Mailpit integration test and E2E tests
MAILPIT_SMTP_PORT=51025
MAILPIT_UI_PORT=58025
MAILPIT_API_URL=http://127.0.0.1:58025

# Web (Vite dev server proxies /api to this URL)
VITE_API_PROXY_TARGET=http://localhost:3001
